{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "GITHUB_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.mjs",
        "$TURBO_ROOT$/packages/config/tsdown.mjs",
        "$TURBO_ROOT$/packages/config/tsconfig/**"
      ],
      "outputs": [
        ".dist/**"
      ],
      "env": [
        "CODECOV_TOKEN"
      ]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "//#lint": {},
    "lint:check": {},
    "//#lint:check": {},
    "lint:types": {},
    "test": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.mjs",
        "$TURBO_ROOT$/packages/config/vitest.mjs",
        "$TURBO_ROOT$/packages/config/tsconfig/**"
      ],
      "env": [
        "CI"
      ],
      "outputs": [
        ".coverage/**",
        ".coverage-ts/**",
        "junit.xml"
      ]
    }
  }
}
